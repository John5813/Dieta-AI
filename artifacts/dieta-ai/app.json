{
  "expo": {
    "name": "UzDieta AI - Kaloriya Hisobi",
    "slug": "uzdieta-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uzdieta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.uzdieta.app"
    },
    "android": {
      "package": "uz.uzdieta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E8F5E9"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "newArchEnabled": true,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://dietaai-lexhk.ondigitalocean.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Oziq-ovqat rasmlarini tahlil qilish uchun ruxsat.",
          "cameraPermission": "Oziq-ovqat suratga olish uchun ruxsat."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ovqatni suratga olish va mahsulot shtrix-kodini skanerlash uchun kamera kerak.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Kunlik qadamlaringizni hisoblash uchun harakat ma'lumotlari kerak."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "javlon5813"
  }
}
