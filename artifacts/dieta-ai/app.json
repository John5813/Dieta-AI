{
  "expo": {
    "name": "Kaloria.uz",
    "slug": "uzdieta-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uzdieta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F5ED"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.uzdieta.app"
    },
    "android": {
      "package": "uz.uzdieta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#F9F5ED"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "newArchEnabled": true,
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://dietaai-aj7r4.ondigitalocean.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Oziq-ovqat rasmlarini tahlil qilish uchun ruxsat.",
          "cameraPermission": "Oziq-ovqat suratga olish uchun ruxsat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ovqatni suratga olish va mahsulot shtrix-kodini skanerlash uchun kamera kerak.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Kunlik qadamlaringizni hisoblash uchun harakat ma'lumotlari kerak."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2D7A2D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "javlon5813",
    "extra": {
      "eas": {
        "projectId": "183cee9f-376d-42fe-9c23-0991a59ca9a9"
      }
    }
  }
}
