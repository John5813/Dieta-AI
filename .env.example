# Required at runtime
DATABASE_URL=postgresql://dieta:change-me@postgres:5432/dieta
POSTGRES_PASSWORD=change-me

# Telegram bot. Leave empty only when the bot is intentionally disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=30000

# AI provider used by the existing AI routes
OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Payment/admin settings
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_OWNER=
MASTER_LOGIN=
MASTER_PASSWORD=

# --- Security / cost protection ---
# 32+ random characters; signs premium tokens. Generate: openssl rand -hex 32
PREMIUM_TOKEN_SECRET=
# Reverse proxies in front of the server (DigitalOcean App Platform = 1).
# Check the "client ip probe" lines in the logs after deploy.
TRUST_PROXY=1
# Max weighted AI calls per 24h for the WHOLE server (image/plan = 3, text/chat = 1).
AI_GLOBAL_DAILY_BUDGET=6000
# Max AI calls running at the same time.
AI_MAX_INFLIGHT=25
# Extra browser origins allowed to call the API (comma separated). PUBLIC_BASE_URL is always allowed.
CORS_ORIGINS=
# MASTER_LOGIN / MASTER_PASSWORD: leave EMPTY unless both are 12+ random characters.
