# Required at runtime
DATABASE_URL=postgresql://dieta:change-me@postgres:5432/dieta
POSTGRES_PASSWORD=change-me

# Telegram bot. Leave empty only when the bot is intentionally disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=30000

# AI provider used by the existing AI routes
OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Payment/admin settings
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_OWNER=
MASTER_LOGIN=
MASTER_PASSWORD=

# --- Security / cost protection ---
# 32+ random characters; signs premium tokens. Generate: openssl rand -hex 32
PREMIUM_TOKEN_SECRET=
# Reverse proxies in front of the server (DigitalOcean App Platform = 1).
# Check the "client ip probe" lines in the logs after deploy.
TRUST_PROXY=1
# Max weighted AI calls per 24h for the WHOLE server (image/plan = 3, text/chat = 1).
AI_GLOBAL_DAILY_BUDGET=6000
# Max AI calls running at the same time.
AI_MAX_INFLIGHT=25
# Extra browser origins allowed to call the API (comma separated). PUBLIC_BASE_URL is always allowed.
CORS_ORIGINS=
# MASTER_LOGIN / MASTER_PASSWORD: leave EMPTY unless both are 12+ random characters.

# --- kaloria.uz website & CRM ---
# Public https address of the site (used for links, CORS and payment return URLs).
PUBLIC_BASE_URL=https://kaloria.uz
# so'm per delivery day for each ration. Until this is set the site shows sample prices.
SITE_PRICES={"ozish":159000,"balans":179000,"sport":209000}
# Discount percent per plan: d3 = 3-day trial, w1..w4 = weeks, m1 = 1 month (26 delivery days).
SITE_DISCOUNTS={"d3":0,"w1":0,"w2":3,"w3":5,"w4":7,"m1":10}
# Sales manager contacts shown on the site.
MANAGER_TELEGRAM_URL=https://t.me/your_manager
MANAGER_PHONE=+998901234567
# Telegram chat (group or person) that receives new website leads; falls back to TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_LEADS_CHAT_ID=
# Optional ad pixels (Instagram/Facebook and TikTok).
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
YANDEX_METRIKA_ID=
# Seller details shown in the footer and the public offer (also used by /pay).
MERCHANT_LEGAL_NAME=
MERCHANT_INN=
MERCHANT_ADDRESS=
# Optional site texts; a block stays hidden while its variable is empty.
SITE_DELIVERY_UZ=
SITE_DELIVERY_RU=
SITE_KITCHEN_UZ=
SITE_KITCHEN_RU=
SITE_DIETITIAN_UZ=
SITE_DIETITIAN_RU=
SITE_INSTAGRAM_URL=

# --- CRM (/admin) ---
# Signs admin session cookies (32+ random characters). Falls back to PREMIUM_TOKEN_SECRET.
ADMIN_SESSION_SECRET=
# Telegram user ids (comma separated) that become CRM owners on their first /login.
# TELEGRAM_ADMIN_CHAT_ID is always included when it is a private chat id.
ADMIN_OWNER_TELEGRAM_IDS=
